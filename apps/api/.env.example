# Configuración SMTP (ejemplo)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_USE_TLS=true

# Email defaults
# EMAIL_FROM debe ser tu SMTP_USER o un alias configurado en el proveedor SMTP
EMAIL_FROM=no-reply@example.com
EMAIL_TO=notify@example.com

# JWT: debe ser una clave secreta larga y segura en produccion
SECRET_KEY=un_secreto_muy_seguro_cambiar_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Token para invocar endpoints protegidos desde CI/CD (no comitear secretos reales)
API_TOKEN=un_token_secreto_largo_aqui

# Base de datos Neon PostgreSQL
# Pega aquí la cadena que te da Neon desde Connection string.
# Ejemplo:
# DATABASE_URL=postgresql://usuario:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Pool de conexiones (solo aplica para PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS: origenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://marianas.vercel.app,https://mariana-app-nu.vercel.app

# Rama Judicial SSL verification (deshabilitar solo si hay problemas de certificado)
RAMA_VERIFY_SSL=true

# URL pública de la API (keepalive para Render)
API_URL=https://marianas-api.onrender.com

# URL pública del frontend
APP_URL=https://marianas.vercel.app

# Brevo (canal primario de correo via API HTTPS; Render bloquea SMTP saliente)
# Cuenta gratis en brevo.com, verificar remitente y generar API key (xkeysib-...)
BREVO_API_KEY=

# SendGrid (alternativa a SMTP)
SENDGRID_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sentry (monitoreo de errores)
SENTRY_DSN=
