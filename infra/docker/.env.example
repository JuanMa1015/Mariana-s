# SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_USE_TLS=true

# Email defaults
EMAIL_FROM=${SMTP_USER}
EMAIL_TO=notify@example.com

# JWT secret key
SECRET_KEY=un_secreto_muy_seguro_cambiar_en_produccion
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Token for CI/CD calls
API_TOKEN=un_token_secreto_largo_aqui

# DB: leave as file in apps/api (mounted by compose)
# For production use Neon or another external PostgreSQL database.
# Example:
# DATABASE_URL=postgresql://usuario:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://usuario:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DB Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://marianas.vercel.app,https://mariana-app-nu.vercel.app

# SSL verify for Rama Judicial
RAMA_VERIFY_SSL=true

# Public URLs
API_URL=
APP_URL=https://marianas.vercel.app

# Optional: SendGrid, Telegram, Sentry
SENDGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SENTRY_DSN=
